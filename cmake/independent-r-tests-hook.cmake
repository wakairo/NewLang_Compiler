# T991 finite opt-in pilot. Injected *after* top-level project(), deferred to
# the end of the original root directory so existing CTest/P982 gates remain intact.
# This file is tooling-only and never grants NewLang source/owner authority.
if(NOT PROJECT_NAME STREQUAL "NewLangCompiler")
    return()
endif()

function(_t991_late_register)
    if(NOT BUILD_TESTING)
        return()
    endif()
    if(NOT TARGET newlangc OR NOT Python3_EXECUTABLE)
        message(FATAL_ERROR "T991: original compiler/Python unavailable")
    endif()
    # Fixed, reviewable pilot allowlist. No external paths, dynamic glob or eval.
    set(_t991_manifest "${CMAKE_SOURCE_DIR}/tests/t991/approved-tests.cmake")
    if(NOT EXISTS "${_t991_manifest}")
        message(STATUS "T991: no approved sidecar; no extra CTests")
        return()
    endif()
    get_property(_before DIRECTORY PROPERTY TESTS)
    foreach(_n t991_contract_accept.integration t991_contract_reject.integration)
        if(_n IN_LIST _before)
            message(FATAL_ERROR "T991: duplicate test before registration: ${_n}")
        endif()
    endforeach()
    include("${_t991_manifest}")
    get_property(_after DIRECTORY PROPERTY TESTS)
    list(LENGTH _before _b)
    list(LENGTH _after _a)
    math(EXPR _wanted "${_b} + 2")
    if(NOT _a EQUAL _wanted)
        message(FATAL_ERROR "T991: expected exactly two sidecar tests")
    endif()
    foreach(_n t991_contract_accept.integration t991_contract_reject.integration)
        if(NOT _n IN_LIST _after)
            message(FATAL_ERROR "T991: missing required CTest: ${_n}")
        endif()
    endforeach()
    message(STATUS "T991: exactly two approved synthetic CTests registered")
endfunction()

cmake_language(DEFER CALL _t991_late_register)

# T993 declarative enrollment bridge. The manifest itself is NEVER included or
# evaluated as CMake, and the caller cannot select an arbitrary path.
function(_t993_late_register)
    if(NOT BUILD_TESTING)
        return()
    endif()
    if(NOT TARGET newlangc OR NOT Python3_EXECUTABLE)
        message(FATAL_ERROR "T993: original compiler/Python unavailable")
    endif()
    set(_r_manifest "${CMAKE_SOURCE_DIR}/tests/r/approved-cohort-manifest.txt")
    set(_pilot_manifest "${CMAKE_SOURCE_DIR}/tests/t993/approved-cohort-manifest.txt")
    if(IS_SYMLINK "${_r_manifest}" OR IS_SYMLINK "${_pilot_manifest}"
       OR IS_SYMLINK "${CMAKE_SOURCE_DIR}/tests/r")
        message(FATAL_ERROR "T993: symlink manifest or R directory; STOP")
    endif()
    if(EXISTS "${_r_manifest}" AND EXISTS "${_pilot_manifest}")
        message(FATAL_ERROR "T993: competing R and synthetic manifest; STOP")
    endif()
    if(EXISTS "${_r_manifest}")
        set(_manifest "${_r_manifest}")
    elseif(EXISTS "${_pilot_manifest}")
        set(_manifest "${_pilot_manifest}")
    else()
        message(STATUS "T993: no approved R manifest; zero R CTests registered")
        return()
    endif()
    set(_generated "${CMAKE_CURRENT_BINARY_DIR}/t993-validated-tests.cmake")
    execute_process(COMMAND "${Python3_EXECUTABLE}"
        "${CMAKE_SOURCE_DIR}/cmake/independent-r-manifest.py"
        "${CMAKE_SOURCE_DIR}" "${_manifest}" "${_generated}"
        RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(NOT "${_rc}" STREQUAL "0")
        message(FATAL_ERROR "T993: rejected declarative manifest: ${_rc} ${_err}")
    endif()
    get_property(_before DIRECTORY PROPERTY TESTS)
    # Includes ONLY T-owned generator output in the build dir, never R text.
    include("${_generated}")
    list(LENGTH _t993_names _added)
    get_property(_after DIRECTORY PROPERTY TESTS)
    list(LENGTH _before _old)
    list(LENGTH _after _total)
    math(EXPR _expected "${_old} + ${_added}")
    if(NOT _total EQUAL _expected)
        message(FATAL_ERROR "T993: CTest inventory mismatch")
    endif()
    foreach(_n IN LISTS _t993_names)
        if(NOT _n IN_LIST _after)
            message(FATAL_ERROR "T993: expected CTest absent: ${_n}")
        endif()
    endforeach()
    message(STATUS "T993: strict declarative manifest registered ${_added} CHECK-only CTests")
endfunction()
cmake_language(DEFER CALL _t993_late_register)
