fn basalt_return(tokens: usize) -> usize {
    let quotient = tokens / usize(13);
    let recorded = quotient;
    let courier = recorded;
    return quotient;
}

fn main() -> unit {
    let first = basalt_return(usize(1059));
    let preserved = first;
    let second = basalt_return(preserved);
    let raised = second + usize(7);
    let below = raised - usize(1);
    let terminal = basalt_return(below);
    let reused = first + usize(1);
    unit
}
