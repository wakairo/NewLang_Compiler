fn route(sample: usize) -> u8 {
    let judge = sample < usize(401);
    let picked = if (judge) { u8(157) } else { u8(232) };
    let hop = picked;
    let relay = hop;
    return relay;
}
fn main() -> unit {
    let a = route(usize(400));
    let b = route(usize(401));
    let c = route(usize(403));
    return unit;
}
