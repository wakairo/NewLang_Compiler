  "observation_contract": {
    "headers": "Observe the actual current carry at each generated loop header, including the terminating header. Expected trace is an exact ordered sequence; no synthetic carry or count is permitted.",
    "exact_frame": "Each header has original fields equal to initial[] and remote fields equal to other[]. Continue changes only the quantity carry. All current, sibling and remote reads must come from actual guest lvalues.",
    "break": "Exactly one normal Break. The helper's actual ref destination aliases the selected field of the original; it returns the old Copy. The actual post-B state and loop result must match expected_locals.",
    "caller": "The subsequent independent helper call aliases the same selected original field and returns B's installed current value. Preserve the earlier old Copy, sibling and separate original.",
    "identity": "Within each execution the original root and both field addresses persist across headers, B, helper calls and caller; remote root and fields are distinct objects. Absolute addresses and cross-run addresses are not predicted. Guest state and authority must never be created by the observer.",
    "unmodified": "Compile and execute the unmodified generated translation unit separately from a passive instrumented copy. Keep both exact byte streams and hashes.",
    "passive": "Instrumentation may read actual guest locals/lvalues and emit traces. It must not change guest operands, control flow, arithmetic, state, or permissions. Compare observations with this frozen oracle; do not emit expected trace values as observations.",
    "scope": "Public owned/source authority observations and C17 behavior do not prove private inference or general soundness.",
    "stages": [
      "CHECK",
      "SOURCE_ISSUED_PUBLIC_OWNED_WHEN_REQUIRED",
      "C17_EMIT",
      "STRICT_C17_COMPILE",
      "UNMODIFIED_NATIVE",
      "PASSIVE_NATIVE_TRACE",
      "NEGATIVE_CHECK",
      "APPLICABLE_HOST_GUEST_SANITIZERS"
    ],
    "first_failure": "Preserve every initial diagnostic and raw artifact. Report later stages as NOT_RUN for the affected case; never execute checked-rejected, unsafe or divergent input."
  },
