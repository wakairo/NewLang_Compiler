fn main() -> unit {
    let start = usize(817);
    let total = ledger(start);
    let repeated = ledger(usize(348));
    let direct = basket(usize(164));
    let balance = parts(usize(734));
    let observed = balance % usize(6);
    let sum = total + repeated;
    return unit;
}

fn ledger(material: usize) -> usize {
    let checked = parts(material);
    let balance = basket(checked);
    let kept = balance;
    kept
}

fn basket(amount: usize) -> usize {
    let used = parts(amount);
    let peer = parts(used);
    let accepted = peer % usize(5);
    let upload = accepted;
    return upload;
}

fn parts(items: usize) -> usize {
    let seen = items;
    let counted = seen / usize(3);
    let pending = counted % usize(97);
    let quota = usize(19);
    let allowance = quota + usize(11);
    let spare = allowance - usize(4);
    let logged = pending;
    logged
}
