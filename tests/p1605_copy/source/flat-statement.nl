fn forward(seed: usize) -> usize {
    seed;
    let carried = seed;
    carried;
    return carried;
}

fn main() -> unit {
    let origin = usize(63);
    origin;
    let parts = origin / usize(7);
    parts;
    let checked = forward(parts);
    checked;
    let residue = checked % usize(5);
    residue;
    unit
}
