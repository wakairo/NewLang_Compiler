struct Meridian {
    dawn: u8,
    dusk: u8,
}

fn main() -> unit {
    let north = Meridian { dusk: u8(255), dawn: u8(0) };
    let south = Meridian { dawn: u8(73), dusk: u8(19) };
    if (usize(17) == usize(17)) { loan_write(north@dawn) { |w| replace(w, u8(9)); unit } } else { unit };
    unit
}
