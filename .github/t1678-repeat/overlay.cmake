# Heavy-2 only. Register original CTests and defer until their properties are set.
if(NOT PROJECT_NAME STREQUAL "NewLangCompiler")
    return()
endif()
include("${CMAKE_SOURCE_DIR}/cmake/independent-r-tests-hook.cmake")

function(_t1678_shadow_pair)
    get_property(_actual DIRECTORY PROPERTY TESTS)
    list(SORT _actual)
    file(STRINGS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/inventory.tsv" _expected)
    list(TRANSFORM _expected REPLACE "\t.*$" "")
    if(NOT "${_actual}" STREQUAL "${_expected}")
        message(FATAL_ERROR "T1678 original registration differs from its approved inventory")
    endif()
    foreach(_test p1291_named_oom.integration p1299_named_oom.integration)
        get_property(_serial TEST "${_test}" PROPERTY RUN_SERIAL)
        if(NOT _serial)
            message(FATAL_ERROR "T1678 original RUN_SERIAL missing for ${_test}")
        endif()
        set_property(TEST "${_test}" PROPERTY RUN_SERIAL)
        get_property(_serial_set TEST "${_test}" PROPERTY RUN_SERIAL SET)
        if(_serial_set)
            message(FATAL_ERROR "T1678 failed to clear RUN_SERIAL for ${_test}")
        endif()
    endforeach()
    message(STATUS "T1678: cleared original RUN_SERIAL for the approved pair")
endfunction()

function(_t1678_queue_final_pair)
    cmake_language(DEFER CALL _t1678_shadow_pair)
endfunction()
cmake_language(DEFER CALL _t1678_queue_final_pair)
